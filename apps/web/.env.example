# ==============================================================================
# Axiom NHI Web Platform — Environment Variables
# ==============================================================================

# Authentication (Clerk or Enterprise OIDC)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Transactional Email (Resend or SMTP)
RESEND_API_KEY=re_xxx
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_xxx
CONTACT_TO_EMAIL=founders@axiomnhi.dev

# Analytics & Bot Protection
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAxxx
TURNSTILE_SECRET_KEY=0x4AAAxxx

# CRM / Slack Lead Routing (Webhook)
SLACK_LEADS_WEBHOOK_URL=https://hooks.slack.com/services/xxx
