{
  "mcpServers": {
    "k6": {
      "command": "uvx",
      "args": ["k6-mcp-server"],
      "timeoutSeconds": 300
    },
    "trivy": {
      "command": "trivy",
      "args": ["mcp"]
    },
    "owasp-zap": {
      "url": "https://localhost:8282/mcp",
      "serverUrl": "https://localhost:8282/mcp",
      "headers": {
        "Authorization": "Bearer ${ZAP_MCP_KEY}"
      }
    },
    "kubernetes": {
      "command": "npx",
      "args": ["-y", "kubernetes-mcp-server@latest", "--read-only"],
      "enabledTools": ["pods_list", "pods_log", "resources_list", "resources_get"]
    },
    "grafana": {
      "command": "uvx",
      "args": ["mcp-grafana"],
      "env": {
        "GRAFANA_URL": "http://localhost:3000",
        "GRAFANA_API_KEY": "${GRAFANA_API_KEY}"
      }
    },
    "google-dev-docs": {
      "url": "https://developerknowledge.googleapis.com/mcp",
      "serverUrl": "https://developerknowledge.googleapis.com/mcp",
      "authProviderType": "google_credentials",
      "headers": {
        "X-goog-user-project": "${GOOGLE_CLOUD_PROJECT}"
      }
    },
    "supabase": {
      "url": "https://mcp.supabase.com/mcp?read_only=false",
      "serverUrl": "https://mcp.supabase.com/mcp?read_only=false"
    },
    "clerk": {
      "url": "https://mcp.clerk.com/mcp",
      "serverUrl": "https://mcp.clerk.com/mcp"
    },
    "composio": {
      "url": "https://mcp.composio.dev/mcp",
      "serverUrl": "https://mcp.composio.dev/mcp",
      "headers": {
        "x-api-key": "${COMPOSIO_API_KEY}"
      }
    },
    "stripe": {
      "url": "https://mcp.stripe.com",
      "serverUrl": "https://mcp.stripe.com"
    },
    "aws-iam": {
      "command": "uvx",
      "args": ["awslabs.iam-mcp-server@latest", "--readonly"],
      "env": {
        "AWS_PROFILE": "axiom-dev-readonly"
      },
      "enabledTools": [
        "list_users",
        "list_roles",
        "list_policies",
        "simulate_principal_policy"
      ]
    },
    "slack": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-slack"],
      "env": {
        "SLACK_BOT_TOKEN": "${SLACK_BOT_TOKEN}",
        "SLACK_TEAM_ID": "${SLACK_TEAM_ID}"
      },
      "enabledTools": [
        "slack_post_message",
        "slack_reply_to_thread",
        "slack_add_reaction",
        "slack_get_channel_history"
      ]
    },
    "neon": {
      "command": "npx",
      "args": ["-y", "@neondatabase/mcp-server-neon", "start", "${NEON_API_KEY}"]
    },
    "upstash": {
      "command": "npx",
      "args": ["-y", "@upstash/mcp-server"]
    },
    "cloudflare": {
      "command": "npx",
      "args": ["-y", "@cloudflare/mcp-server-cloudflare"]
    },
    "e2b": {
      "command": "npx",
      "args": ["-y", "@e2b/mcp-server"],
      "env": {
        "E2B_API_KEY": "${E2B_API_KEY}"
      }
    },
    "resend": {
      "command": "npx",
      "args": ["-y", "resend-mcp"],
      "env": {
        "RESEND_API_KEY": "${RESEND_API_KEY}"
      }
    },
    "postgres": {
      "command": "uvx",
      "args": [
        "postgres-mcp",
        "--access-mode=unrestricted"
      ],
      "env": {
        "DATABASE_URI": "postgresql://axiom:axiom_dev@localhost:5432/axiom_nhi"
      }
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"]
    },
    "opentelemetry": {
      "command": "uvx",
      "args": ["opentelemetry-mcp"],
      "env": {
        "BACKEND_TYPE": "jaeger",
        "BACKEND_URL": "http://localhost:16686"
      }
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "shadcn": {
      "command": "npx",
      "args": ["-y", "shadcn@latest", "mcp"]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "@ChromeDevTools/chrome-devtools-mcp@latest"]
    },
    "21st": {
      "url": "https://21st.dev/api/mcp",
      "serverUrl": "https://21st.dev/api/mcp",
      "headers": {
        "x-api-key": "${API_KEY_21ST}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@executeautomation/playwright-mcp-server"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "fetch-docs": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-fetch"]
    },
    "workspace-filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:\\Users\\Lenovo\\Desktop\\Axiom"
      ]
    },
    "docker": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-v",
        "/var/run/docker.sock:/var/run/docker.sock",
        "ghcr.io/docker/mcp-server:latest"
      ]
    },
    "agentgateway-extmcp-local": {
      "url": "http://localhost:8080/mcp"
    }
  }
}
