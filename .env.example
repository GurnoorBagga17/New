# Axiom NHI - Environment Configuration Template
# Copy this file to .env.local and fill in the values

# =============================================================================
# Application Environment
# =============================================================================
NODE_ENV=development
AXIOM_ENV=development

# Development Mode (NEVER set to 1 in production)
AXIOM_DEV_MODE=1
AXIOM_ALLOW_ANONYMOUS_LOCAL=1

# =============================================================================
# Database (Required)
# =============================================================================
DATABASE_URL=postgresql://axiom:axiom_dev_password@localhost:5432/axiom_dev

# Test database for running test suite
TEST_DATABASE_URL=postgresql://axiom:axiom_dev_password@localhost:5432/axiom_test

# =============================================================================
# Admin API (Required)
# =============================================================================
# Backend Rust control plane URL
AXIOM_ADMIN_API_URL=http://127.0.0.1:8787

# Admin service token (generate with: openssl rand -hex 32)
# REQUIRED in production, has fallback in dev mode
AXIOM_ADMIN_TOKEN=axm_local_dev_token_for_browser_testing

# =============================================================================
# Next.js Web App (Required)
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Billing - Stripe (Optional for development, Required for production)
# =============================================================================
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs from Stripe dashboard (Products & Pricing)
STRIPE_PRICE_EVAL=price_...
STRIPE_PRICE_TEAM=price_...

# =============================================================================
# Step-Up Authentication (Optional for development)
# =============================================================================
# Secret for HMAC-based step-up signature verification
# Generate with: openssl rand -hex 32
AXIOM_STEPUP_SECRET=

# =============================================================================
# Redis (Optional - for rate limiting and caching)
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# OpenBao / Secrets Management (Optional - for credential encryption)
# =============================================================================
OPENBAO_ADDR=http://localhost:8200
OPENBAO_TOKEN=

# =============================================================================
# Observability (Optional)
# =============================================================================
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# =============================================================================
# Data Storage
# =============================================================================
# Local data directory for file-backed stores
AXIOM_DATA_DIR=../../data/axiom

# S3 bucket for artifacts, SBOMs, backups (production)
S3_BUCKET=
AWS_REGION=us-east-1

# =============================================================================
# Feature Flags (Optional)
# =============================================================================
ENABLE_EXPERIMENTAL_FEATURES=false

# =============================================================================
# Security
# =============================================================================
# Session secret for cookie signing (generate with: openssl rand -base64 32)
SESSION_SECRET=

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# =============================================================================
# Connector Credentials (Development Only)
# =============================================================================
# AWS IAM (for testing connector)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ROLE_ARN=
AWS_EXTERNAL_ID=

# GitHub App (for testing connector)
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=

# =============================================================================
# NOTES
# =============================================================================
# 1. NEVER commit .env.local or .env.production to version control
# 2. Rotate all secrets regularly (every 90 days minimum)
# 3. Use a secrets manager (AWS Secrets Manager, Vault) in production
# 4. Set AXIOM_DEV_MODE=0 in production
# 5. Generate strong random values for all secrets
