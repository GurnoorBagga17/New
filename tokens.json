  "shared": {
    "radii": {
      "input": {
        "$type": "dimension",
        "$value": "6px"
      },
      "card": {
        "$type": "dimension",
        "$value": "10px"
      },
      "modal": {
        "$type": "dimension",
        "$value": "14px"
      }
    },
    "typography": {
      "font-family": {
        "display": {
          "$type": "fontFamily",
          "$value": "Space Grotesk Variable, Plus Jakarta Sans, sans-serif"
        },
        "sans": {
          "$type": "fontFamily",
          "$value": "Inter Variable, Geist Sans, system-ui, sans-serif"
        },
        "mono": {
          "$type": "fontFamily",
          "$value": "JetBrains Mono Variable, Geist Mono, monospace"
        }
      },
      "role": {
        "hero-display": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{shared.typography.font-family.display}",
            "fontSize": "56px",
            "fontWeight": 700,
            "lineHeight": 1.08,
            "letterSpacing": "-0.035em"
          }
        },
        "section-title": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{shared.typography.font-family.display}",
            "fontSize": "36px",
            "fontWeight": 600,
            "lineHeight": 1.15,
            "letterSpacing": "-0.025em"
          }
        },
        "console-page-title": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{shared.typography.font-family.sans}",
            "fontSize": "22px",
            "fontWeight": 600,
            "lineHeight": 1.3,
            "letterSpacing": "-0.015em",
            "fontFeatureSettings": "cv02, cv03, cv04, cv11"
          }
        },
        "card-header": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{shared.typography.font-family.sans}",
            "fontSize": "15px",
            "fontWeight": 600,
            "lineHeight": 1.4,
            "letterSpacing": "-0.01em",
            "fontFeatureSettings": "cv02, cv03, cv04, cv11"
          }
        },
        "body": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{shared.typography.font-family.sans}",
            "fontSize": "14px",
            "fontWeight": 400,
            "lineHeight": 1.5,
            "letterSpacing": "0em",
            "fontFeatureSettings": "cv02, cv03, cv04, cv11"
          }
        },
        "table-label": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{shared.typography.font-family.sans}",
            "fontSize": "13px",
            "fontWeight": 500,
            "lineHeight": 1.4,
            "letterSpacing": "0em",
            "fontFeatureSettings": "cv02, cv03, cv04, cv11"
          }
        },
        "overline": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{shared.typography.font-family.mono}",
            "fontSize": "11px",
            "fontWeight": 500,
            "lineHeight": 1.2,
            "letterSpacing": "0.08em",
            "textTransform": "uppercase"
          }
        },
        "technical": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{shared.typography.font-family.mono}",
            "fontSize": "12.5px",
            "fontWeight": 400,
            "lineHeight": 1.55,
            "letterSpacing": "0em",
            "fontVariantNumeric": "tabular-nums"
          }
        }
      }
    },
    "motion": {
      "spring-tactile": {
        "$type": "spring",
        "$value": {
          "stiffness": 480,
          "damping": 34,
          "mass": 0.8
        }
      },
      "spring-drawer": {
        "$type": "spring",
        "$value": {
          "stiffness": 360,
          "damping": 36,
          "mass": 1.0
        }
      },
      "ease-telemetry": {
        "$type": "cubicBezier",
        "$value": {
          "curve": [
            0.16,
            1,
            0.3,
            1
          ],
          "durationMs": 220
        }
      },
      "ease-pulse": {
        "$type": "cubicBezier",
        "$value": {
          "curve": [
            0.4,
            0,
            0.6,
            1
          ],
          "durationMs": 2400,
          "loop": true
        }
      },
      "intercept-beam": {
        "$type": "motion",
        "$value": {
          "property": [
            "transform",
            "opacity"
          ],
          "durationMs": 180
        }
      },
      "allow-flash": {
        "$type": "motion",
        "$value": {
          "property": [
            "transform",
            "opacity"
          ],
          "durationMs": 250
        }
      },
      "deny-shake": {
        "$type": "motion",
        "$value": {
          "property": [
            "transform",
            "opacity"
          ],
          "x": [
            -3,
            3,
            -2,
            2,
            0
          ],
          "durationMs": 200
        }
      },
      "kill-switch-hold": {
        "$type": "duration",
        "$value": "400ms"
      },
      "kill-switch-ring": {
        "$type": "motion",
        "$value": {
          "property": [
            "transform",
            "opacity"
          ],
          "scale": [
            0.8,
            2.4
          ],
          "durationMs": 450
        }
      }
    },
    "elevation": {
      "surface-border": {
        "$type": "shadow",
        "$value": "0 0 0 1px rgba(255, 255, 255, 0.08)"
      },
      "top-edge-highlight": {
        "$type": "shadow",
        "$value": "inset 0 1px 0 rgba(255, 255, 255, 0.06)"
      }
    },
    "semantics": {
      "verdict-display-map": {
        "$type": "other",
        "$value": {
          "ALLOW": "ENFORCE",
          "WOULD_DENY": "OBSERVE",
          "PENDING": "PENDING",
          "DENY": "DENY",
          "REVOKED": "REVOKED",
          "unknown": "UNKNOWN"
        }
      }
    }
  }
}
