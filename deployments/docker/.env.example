# Axiom NHI — Docker Compose Environment Template
# Copy this file to .env in this directory or project root before running docker compose.
# Generate secrets using: openssl rand -hex 32

# PostgreSQL credentials (REQUIRED)
POSTGRES_USER=axiom
POSTGRES_PASSWORD=
POSTGRES_DB=axiom_prod

# Axiom Control Plane Admin Token (REQUIRED — minimum 32 characters)
AXIOM_ADMIN_TOKEN=
AXIOM_ADMIN_ACTOR=prod-operator

# Web Session Secret (REQUIRED in production — minimum 32 characters)
SESSION_SECRET=

# Public Web URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenBao (Optional)
OPENBAO_TOKEN=
OPENBAO_ADDR=
