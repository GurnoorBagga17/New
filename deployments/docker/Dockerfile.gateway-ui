FROM node:22-bookworm-slim AS builder
WORKDIR /build
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
COPY . .
RUN pnpm install --frozen-lockfile && pnpm --filter @axiom/gateway-ui build

FROM node:22-bookworm-slim
WORKDIR /app
USER 65532:65532
COPY --from=builder /build/apps/gateway-ui/dist /app/apps/gateway-ui/dist
COPY gateway/local-admin-api /app/gateway/local-admin-api
EXPOSE 8080
CMD ["node", "/app/gateway/local-admin-api/server.cjs"]
