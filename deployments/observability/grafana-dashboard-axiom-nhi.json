{
  "title": "Axiom NHI \u2014 Inline Runtime & Identity Lineage Operations",
  "uid": "axiom-nhi-ops-v1",
  "schemaVersion": 39,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "ExtMCP Inline Authorization Latency (p50 / p95 / p99 < 5ms)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(axiom_nhi_extmcp_eval_duration_ms_bucket[1m])) by (le))"
        }
      ]
    },
    {
      "id": 2,
      "title": "MCP Tool Verdict Stream (ALLOW vs DENY vs WOULD_DENY)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum by (decision) (rate(axiom_nhi_decisions_total[5m]))"
        }
      ]
    },
    {
      "id": 3,
      "title": "OpenBao Attested Ephemeral Secret Leases & Dual-Secret Rotations",
      "type": "gauge",
      "targets": [
        {
          "expr": "axiom_nhi_active_attested_leases_total"
        }
      ]
    }
  ]
}