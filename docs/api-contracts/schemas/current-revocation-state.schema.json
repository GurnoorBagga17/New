{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.invalid/schemas/0.1.0-draft/revocation-state.json",
  "title": "Current RevocationState DTO",
  "description": "Session is not a supported target kind in the current backend enum.",
  "type": "object",
  "additionalProperties": false,
  "required": ["target_kind", "target_id", "revoked", "state_version", "effective_unix_ms", "reason"],
  "properties": {
    "target_kind": { "type": "string", "enum": ["global", "mcp_server", "agent", "tool"] },
    "target_id": { "type": "string" },
    "revoked": { "type": "boolean" },
    "state_version": { "type": "integer", "minimum": 0 },
    "effective_unix_ms": { "type": "integer" },
    "reason": { "type": "string" }
  }
}
