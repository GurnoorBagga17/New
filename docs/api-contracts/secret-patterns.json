{
  "schema_version": "0.1.0-draft",
  "$description": "Shared fake canary strings and detection patterns for Team 5 redaction, Team 6 tests, and frontend zero-secret scans. Patterns are test inputs only; never use real credentials.",
  "canaries": [
    "AXIOM_TEST_SECRET_DO_NOT_USE_7f3a91",
    "AXIOM_TEST_BEARER_DO_NOT_USE_eyJhbGciOiJub25lIn0.eyJ0ZXN0IjoxfQ.signature",
    "AXIOM_TEST_PRIVATE_KEY_DO_NOT_USE",
    "AKIA0000000000000000",
    "sk-TEST-00000000000000000000000000000000",
    "ghp_TEST00000000000000000000000000000000"
  ],
  "patterns": [
    { "id": "authorization-header", "regex": "(?i)authorization\\s*[:=]\\s*(?:bearer\\s+)?[^\\s,;]+" },
    { "id": "bearer-value", "regex": "(?i)\\bbearer\\s+[a-z0-9._~+/-]+=*" },
    { "id": "jwt-shaped", "regex": "\\beyJ[a-zA-Z0-9_-]{4,}\\.[a-zA-Z0-9_-]{4,}\\.[a-zA-Z0-9_-]*\\b" },
    { "id": "private-key-block", "regex": "-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----" },
    { "id": "secret-assignment", "regex": "(?i)(?:api[_-]?key|client[_-]?secret|password|access[_-]?token)\\s*[:=]\\s*[^\\s,;]+" },
    { "id": "aws-access-key", "regex": "\\bAKIA[0-9A-Z]{16}\\b" },
    { "id": "github-token", "regex": "\\bgh[pousr]_[A-Za-z0-9]{20,}\\b" },
    { "id": "openai-style-key", "regex": "\\bsk-[A-Za-z0-9_-]{20,}\\b" }
  ]
}
